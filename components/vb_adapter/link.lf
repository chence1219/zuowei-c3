# 1) 定义输入段名（你代码里用 __attribute__((section(".vb_cmd_evt")))）
[sections:vb_cmd_evt]
entries:
    .vb_cmd_evt

# 2) 定义把 vb_cmd_evt 这些输入段放到哪个“目标”区（这里放只读 flash_rodata）
[scheme:vb_cmd_evt_scheme]
entries:
    vb_cmd_evt -> flash_rodata

# 3) 为具体归档库（组件）应用映射，并加上 KEEP/SURROUND
#    把 libmain.a 换成你真正的组件库名（lib<component>.a）
[mapping:vb_cmd_evt_map]
archive: libvb_adapter.a
entries:
    * (vb_cmd_evt_scheme);                 # 先选中整个库使用该 scheme
        vb_cmd_evt -> flash_rodata         # 然后对该 section 的这条映射追加 flags
            KEEP() SURROUND(vb_cmd_evt)
