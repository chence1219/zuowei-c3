CONFIG_BOARD_PATH="../../firmware/zuowei_v2/mz19-dqy-c3-v3/00-zuowei-dqy-c3-7014"
CONFIG_ASSETS_FIX_PATH="../firmware/_common_v2/assets_fix"

CONFIG_USE_DEVICE_AEC=y
CONFIG_DEVICE_AEC_DEFAULT_OFF=n

CONFIG_CUSTOM_BOARD_TYPE="zw-dqy-c3-7014-aec"
CONFIG_WIFI_CONFIG_MODE_SSID_PREFIX="zw-dqy-c3"

## BLUFI配网
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
#CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_BLUFI_ENABLE=y
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y
CONFIG_BT_NIMBLE_DIS_SERVICE=n
CONFIG_BT_NIMBLE_HR_SERVICE=n
CONFIG_BT_NIMBLE_SPS_SERVICE=n
CONFIG_BT_NIMBLE_LLS_SERVICE=n
CONFIG_BT_NIMBLE_IAS_SERVICE=n
CONFIG_BT_NIMBLE_TPS_SERVICE=n
CONFIG_BT_NIMBLE_IPSS_SERVICE=n
CONFIG_BT_NIMBLE_HTP_SERVICE=n
CONFIG_BT_NIMBLE_CTS_SERVICE=n
CONFIG_BT_NIMBLE_ANS_SERVICE=n
CONFIG_BT_NIMBLE_PROX_SERVICE=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256 //mtu过短的话发送ssid列表容易超
CONFIG_USE_BLUFI_NET_CONFIGURING=y
CONFIG_WIFI_CONFIG_MODE_AUTO_DELAY_RELEASE_DECODER_TIME=6000