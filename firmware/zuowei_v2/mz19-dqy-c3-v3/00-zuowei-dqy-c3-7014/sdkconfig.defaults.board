CONFIG_BOARD_PATH="../../firmware/zuowei_v2/mz19-dqy-c3-v3/00-zuowei-dqy-c3-7014"
CONFIG_ASSETS_FIX_PATH="../firmware/_common_v2/assets_fix"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v1/8m_modify.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/v1/8m_modify.csv"

CONFIG_USE_DEVICE_AEC=y
CONFIG_DEVICE_AEC_DEFAULT_OFF=y

CONFIG_IOT_PROTOCOL_XIAOZHI=n
CONFIG_IOT_PROTOCOL_MCP=y

CONFIG_WIFI_CONFIG_MODE_FORMAT_DISPLAY=y
CONFIG_WIFI_CONFIG_MODE_SSID_PREFIX="zuowei"

CONFIG_SPEAKING_FIRST_MUTE_TIME=60

CONFIG_USE_CUSTOM_OTA=y


# nertc 
CONFIG_OTA_URL="https://nrtc.netease.im/v1/ota"
CONFIG_CONNECTION_TYPE_NERTC=y
CONFIG_USE_MUSIC_PLAYER=y


CONFIG_VB6824_OTA_SUPPORT=n

# 阿拉伯字体处理
#CONFIG_LV_USE_BIDI=y
#CONFIG_LV_BIDI_DIR_AUTO=y
#CONFIG_LV_USE_ARABIC_PERSIAN_CHARS=y

#CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=4096

CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y


CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16

#CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=1536

CONFIG_VB_UART_RX_BUFFER_SIZE=6144

#CONFIG_USE_BLUFI_NET_CONFIGURING=y

CONFIG_BT_NIMBLE_LOW_SPEED_MODE=y

CONFIG_LV_USE_LZ4=y